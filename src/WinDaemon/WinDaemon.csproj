<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CoreLib\CoreLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Plugin.BLE" Version="3.2.1" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- WPF drives the dashboard. WinForms stays enabled only for NotifyIcon, which WPF
         has no equivalent for, and for the Win32 clipboard interop. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Our own [STAThread] Main is the entry point, so the SDK must not generate one. -->
    <StartupObject>WinDaemon.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Shown on the executable, in the taskbar and in Alt+Tab. Without it the window
         fell back to the generic default icon. -->
    <ApplicationIcon>Resources\meshsync.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also embedded as a resource so the window and tray can load it at runtime. -->
    <Resource Include="Resources\meshsync.ico" />
  </ItemGroup>

</Project>
