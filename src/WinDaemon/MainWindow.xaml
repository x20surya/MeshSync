<Window x:Class="WinDaemon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Mesh Sync"
        Icon="pack://application:,,,/WinDaemon;component/Resources/meshsync.ico"
        Width="860" Height="600"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource B.Bg}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        WindowStyle="None"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Sidebar icons, drawn rather than shipped so they stay crisp and take the theme. -->
        <Style TargetType="Path" x:Key="S.NavIcon">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,11,0" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════ SIDEBAR ══════════════════════ -->
            <Border x:Name="Sidebar" Grid.Column="0" Width="196"
                    Background="{DynamicResource B.Sidebar}"
                    BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand + collapse -->
                    <Grid Grid.Row="0" Height="42" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel x:Name="BrandBlock" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="16,0,0,0">
                            <Viewbox Width="22" Height="13" VerticalAlignment="Center">
                                <Canvas Width="167" Height="99">
                                    <Ellipse Canvas.Left="5.5" Canvas.Top="5.5" Width="88" Height="88"
                                             Stroke="{DynamicResource B.Accent}" StrokeThickness="11" Fill="Transparent" />
                                    <Ellipse Canvas.Left="73.5" Canvas.Top="5.5" Width="88" Height="88"
                                             Stroke="{DynamicResource B.Accent}" StrokeThickness="11" Fill="Transparent" />
                                    <Path Fill="{DynamicResource B.Accent}"
                                          Data="M 83.5 21.6 A 44 44 0 0 1 83.5 77.4 A 44 44 0 0 1 83.5 21.6 Z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="BrandText" Text="MESH SYNC" FontWeight="SemiBold" FontSize="11"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button x:Name="BtnCollapse" Style="{StaticResource S.BtnCaption}"
                                Width="38" HorizontalAlignment="Right" Click="BtnCollapse_Click"
                                ToolTip="Collapse the sidebar">
                            <Path Data="M 0,0 L 12,0 L 12,12 L 0,12 Z M 4.5,0 L 4.5,12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" Fill="Transparent" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="{DynamicResource B.Border}" Margin="0,0,0,8" />

                    <!-- Navigation -->
                    <StackPanel Grid.Row="2">
                        <RadioButton x:Name="NavHome" Style="{StaticResource S.NavItem}" GroupName="Nav"
                                     IsChecked="True" Checked="Nav_Checked" Tag="Home">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource S.NavIcon}"
                                      Data="M 1,7 L 9,1 L 17,7 L 17,17 L 11,17 L 11,11 L 7,11 L 7,17 L 1,17 Z" />
                                <TextBlock Text="Home" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavActivity" Style="{StaticResource S.NavItem}" GroupName="Nav"
                                     Checked="Nav_Checked" Tag="Activity">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource S.NavIcon}"
                                      Data="M 1,11 L 5,11 L 7,5 L 10,15 L 12,9 L 14,11 L 17,11" />
                                <TextBlock Text="Activity" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavNotifications" Style="{StaticResource S.NavItem}" GroupName="Nav"
                                     Checked="Nav_Checked" Tag="Notifications">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource S.NavIcon}"
                                      Data="M 9,2 C 6,2 4,4 4,7 L 4,11 L 2,14 L 16,14 L 14,11 L 14,7 C 14,4 12,2 9,2 Z M 7,15 C 7,16.5 8,17 9,17 C 10,17 11,16.5 11,15" />
                                <TextBlock x:Name="NavNotificationsLabel" Text="Notifications" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavFiles" Style="{StaticResource S.NavItem}" GroupName="Nav"
                                     Checked="Nav_Checked" Tag="Files">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource S.NavIcon}"
                                      Data="M 2,4 L 7,4 L 9,6 L 16,6 L 16,15 L 2,15 Z" />
                                <TextBlock Text="Files" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavDevices" Style="{StaticResource S.NavItem}" GroupName="Nav"
                                     Checked="Nav_Checked" Tag="Devices">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource S.NavIcon}"
                                      Data="M 1,3 L 7,3 L 7,15 L 1,15 Z M 10,6 L 17,6 L 17,13 L 10,13 Z M 9,16 L 18,16" />
                                <TextBlock Text="Devices" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSettings" Style="{StaticResource S.NavItem}" GroupName="Nav"
                                     Checked="Nav_Checked" Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <!-- Hub plus eight spokes: reads as a gear at 17px, where a
                                     properly toothed outline just turns into a blob. -->
                                <Path Style="{StaticResource S.NavIcon}"
                                      Data="M 9,5.5 A 3.5,3.5 0 1 1 9,12.5 A 3.5,3.5 0 1 1 9,5.5 Z
                                            M 9,1 L 9,3.2   M 9,14.8 L 9,17
                                            M 1,9 L 3.2,9   M 14.8,9 L 17,9
                                            M 3.3,3.3 L 4.9,4.9   M 13.1,13.1 L 14.7,14.7
                                            M 14.7,3.3 L 13.1,4.9   M 4.9,13.1 L 3.3,14.7" />
                                <TextBlock Text="Settings" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavAbout" Style="{StaticResource S.NavItem}" GroupName="Nav"
                                     Checked="Nav_Checked" Tag="About">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource S.NavIcon}"
                                      Data="M 9,1 A 8,8 0 1 1 9,17 A 8,8 0 1 1 9,1 Z M 9,8 L 9,13 M 9,5.2 L 9,5.4" />
                                <TextBlock Text="About" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Live status pill -->
                    <Border Grid.Row="3" Margin="12,10,12,14" CornerRadius="8" Padding="11,9"
                            Background="{DynamicResource B.Surface}"
                            BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="SidebarDot" Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{DynamicResource B.Warn}" Margin="0,0,9,0" />
                            <TextBlock x:Name="SidebarStatus" Text="Waiting" FontSize="11.5"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource B.TextMuted}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════════════════ CONTENT ══════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0" Background="{DynamicResource B.Bg}">
                    <TextBlock x:Name="SectionTitle" Text="Home" FontWeight="SemiBold" FontSize="12.5"
                               VerticalAlignment="Center" Margin="24,0,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource S.BtnCaption}" Click="BtnMinimise_Click" ToolTip="Minimise">
                            <Path Data="M 0,0 L 10,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" />
                        </Button>
                        <Button Style="{StaticResource S.BtnCaptionClose}" Click="BtnClose_Click" ToolTip="Hide to tray">
                            <Path Data="M 0,0 L 9,9 M 9,0 L 0,9"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Only up while this machine is the one being looked for. It sits above the
                     content rather than inside a page, because the window may be on any of them
                     when the alarm starts and the way to stop it must not be somewhere else. -->
                <Border x:Name="RingBanner" Grid.Row="1" Visibility="Collapsed"
                        Background="{DynamicResource B.WarnSoft}"
                        BorderBrush="{DynamicResource B.Warn}" BorderThickness="0,0,0,1"
                        Padding="28,12" Panel.ZIndex="10" VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="This computer is ringing" Style="{StaticResource T.Base}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B.Warn}" />
                            <TextBlock x:Name="RingBannerDetail" Style="{StaticResource T.Muted}"
                                       FontSize="12" Margin="0,2,0,0"
                                       Text="Another of your devices is looking for it." />
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource S.BtnPrimary}" Content="Stop"
                                Padding="20,7" VerticalAlignment="Center" Click="BtnStopRinging_Click" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="28,4,28,0">
                    <Grid>

                        <!-- ─────────── HOME ─────────── -->
                        <StackPanel x:Name="PageHome" MaxWidth="460">
                            <Grid Width="112" Height="112" HorizontalAlignment="Center" Margin="0,26,0,0">
                                <Ellipse x:Name="StatusHalo" Width="112" Height="112"
                                         Fill="{DynamicResource B.AccentSoft}" />
                                <Ellipse x:Name="StatusRing" Width="86" Height="86"
                                         Stroke="{DynamicResource B.Accent}" StrokeThickness="2.5" Fill="Transparent" />
                                <Path x:Name="IconTick" Data="M 0,8 L 6.5,14.5 L 19,1"
                                      Stroke="{DynamicResource B.Accent}" StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse x:Name="IconSpinner" Width="86" Height="86"
                                         Stroke="{DynamicResource B.Warn}" StrokeThickness="2.5"
                                         StrokeDashArray="5 4" Fill="Transparent"
                                         Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>

                            <TextBlock x:Name="StatusHeadline" Text="Waiting for a device"
                                       FontFamily="{DynamicResource F.Display}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B.Warn}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,20,0,0" />

                            <TextBlock x:Name="StatusDetail" Style="{StaticResource T.Muted}" FontSize="13.5"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="0,7,0,0"
                                       Text="Open Mesh Sync on another device and scan the pairing code." />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <Button x:Name="BtnPrimary" Style="{StaticResource S.BtnPrimary}"
                                        Content="Pair a device"
                                        MinWidth="168" Click="BtnPrimary_Click" />

                                <Button x:Name="BtnSendFile" Style="{StaticResource S.BtnQuiet}"
                                        Content="Send a file" Padding="18,9" Margin="10,0,0,0"
                                        Visibility="Collapsed" Click="BtnSendFile_Click" />
                            </StackPanel>

                            <TextBlock x:Name="StatusSub" Style="{StaticResource T.Base}" FontSize="12"
                                       Foreground="{DynamicResource B.TextFaint}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" Text="" />

                            <!-- Says the window is a drop target, because nothing else would.
                                 Only shown when there is somewhere for a file to go. -->
                            <TextBlock x:Name="DropHint" Style="{StaticResource T.Base}" FontSize="11.5"
                                       Foreground="{DynamicResource B.TextFaint}"
                                       HorizontalAlignment="Center" Margin="0,16,0,0"
                                       Visibility="Collapsed"
                                       Text="or drop a file anywhere on this window" />

                            <!-- Transport mode, in the spirit of the reference's Mode control -->
                            <TextBlock Text="CONNECTION" Style="{StaticResource T.SectionLabel}" Margin="2,30,0,8" />
                            <ComboBox x:Name="TransportMode" Style="{StaticResource S.Combo}"
                                      SelectionChanged="TransportMode_Changed">
                                <ComboBoxItem Content="Wi-Fi and Bluetooth" Tag="Both" />
                                <ComboBoxItem Content="Wi-Fi only (carries images, needs a network)" Tag="WiFi" />
                                <ComboBoxItem Content="Bluetooth only (text, no network needed)" Tag="Ble" />
                            </ComboBox>
                            <TextBlock x:Name="TransportHint" Style="{StaticResource T.Base}" FontSize="11.5"
                                       Foreground="{DynamicResource B.TextFaint}" TextWrapping="Wrap"
                                       Margin="2,8,0,0"
                                       Text="Bluetooth stays connected and carries text with no network at all. Wi-Fi is brought up when there is an image to send." />

                            <Border Style="{StaticResource S.Card}" Padding="0" Margin="0,22,0,0">
                                <Grid Height="70">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="SentCount" Text="0" FontSize="21" FontWeight="SemiBold"
                                                   FontFamily="{DynamicResource F.Display}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="sent" Style="{StaticResource T.Muted}" FontSize="11"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Rectangle Grid.Column="1" Fill="{DynamicResource B.Border}" Margin="0,16" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="ReceivedCount" Text="0" FontSize="21" FontWeight="SemiBold"
                                                   FontFamily="{DynamicResource F.Display}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="received" Style="{StaticResource T.Muted}" FontSize="11"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Height="28" Background="Transparent" />
                        </StackPanel>

                        <!-- ─────────── NOTIFICATIONS ─────────── -->
                        <StackPanel x:Name="PageNotifications" Visibility="Collapsed" MaxWidth="620">
                            <Grid Margin="0,22,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="From your phone" Style="{StaticResource T.Base}"
                                           FontSize="19" FontWeight="SemiBold"
                                           FontFamily="{DynamicResource F.Display}" />
                                <Button Grid.Column="1" x:Name="BtnClearNotifications"
                                        Style="{StaticResource S.BtnQuiet}" Content="Clear all"
                                        Padding="14,5" FontSize="11.5" VerticalAlignment="Center"
                                        Click="BtnClearNotifications_Click" />
                            </Grid>
                            <TextBlock Style="{StaticResource T.Muted}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="Held in memory only and never written to disk. Dismissing one here dismisses it on the phone too." />

                            <Border Style="{StaticResource S.Card}" Padding="6,4" Margin="0,16,0,0">
                                <StackPanel>
                                    <ItemsControl x:Name="NotificationList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="10,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Heading}" FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Body}" Style="{StaticResource T.Muted}"
                                                                   FontSize="12" Margin="0,2,0,0"
                                                                   TextWrapping="Wrap" MaxHeight="42" />
                                                        <TextBlock Text="{Binding Source}" Style="{StaticResource T.Base}"
                                                                   Foreground="{DynamicResource B.TextFaint}"
                                                                   FontSize="11" Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <Button Grid.Column="1" Style="{StaticResource S.BtnQuiet}"
                                                            Content="Dismiss" Padding="12,5" FontSize="11.5"
                                                            VerticalAlignment="Center" Margin="10,0,0,0"
                                                            Tag="{Binding Key}"
                                                            Click="BtnDismissNotification_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="NotificationsEmpty"
                                               Text="Nothing here. Turn on notification mirroring in the phone's settings and choose which apps to include."
                                               Style="{StaticResource T.Muted}" FontSize="12.5" TextWrapping="Wrap"
                                               Margin="10,16,10,18" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ─────────── ACTIVITY ─────────── -->
                        <StackPanel x:Name="PageActivity" Visibility="Collapsed" MaxWidth="620">
                            <TextBlock Text="Recent syncs" Style="{StaticResource T.Base}" FontSize="19"
                                       FontWeight="SemiBold" FontFamily="{DynamicResource F.Display}"
                                       Margin="0,22,0,4" />
                            <TextBlock Style="{StaticResource T.Muted}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="Held in memory only and cleared when Mesh Sync closes. Clipboard contents are never written to disk." />

                            <Border Style="{StaticResource S.Card}" Padding="6,4" Margin="0,16,0,0">
                                <StackPanel>
                                    <ItemsControl x:Name="ActivityList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="10,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                                                            Background="{DynamicResource B.SurfaceAlt}"
                                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Glyph}" FontSize="12.5"
                                                                   Foreground="{DynamicResource B.TextMuted}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource T.Muted}"
                                                                   FontSize="11" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Age}"
                                                               Foreground="{DynamicResource B.TextFaint}"
                                                               FontSize="11" VerticalAlignment="Center" Margin="8,0,2,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="ActivityEmpty"
                                               Text="Nothing synced yet. Copy something to try it."
                                               Style="{StaticResource T.Muted}" FontSize="12.5"
                                               HorizontalAlignment="Center" Margin="0,26,0,28" />
                                </StackPanel>
                            </Border>
                            <Border Height="28" Background="Transparent" />
                        </StackPanel>

                        <!-- ─────────── DEVICES ─────────── -->
                        <!-- ─────────── FILES ─────────── -->
                        <StackPanel x:Name="PageFiles" Visibility="Collapsed" MaxWidth="620">
                            <TextBlock Text="Files on your devices" Style="{StaticResource T.Base}"
                                       FontSize="19" FontWeight="SemiBold" Margin="0,22,0,4"
                                       FontFamily="{DynamicResource F.Display}" />
                            <TextBlock x:Name="FilesCrumb" Style="{StaticResource T.Muted}" FontSize="12.5"
                                       TextWrapping="Wrap" Text="Choose a device." />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="BtnFilesUp" Style="{StaticResource S.BtnQuiet}" Content="Back"
                                        Padding="14,5" FontSize="11.5" Visibility="Collapsed"
                                        Click="BtnFilesUp_Click" />
                                <TextBlock x:Name="FilesBusy" Text="Asking…" Style="{StaticResource T.Muted}"
                                           FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>

                            <Border Style="{StaticResource S.Card}" Padding="6,4" Margin="0,12,0,0">
                                <StackPanel>
                                    <ItemsControl x:Name="FileList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="10,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource T.Muted}"
                                                                   FontSize="11.5" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <Button Grid.Column="1" Style="{StaticResource S.BtnQuiet}"
                                                            Content="{Binding Action}" Padding="12,5" FontSize="11.5"
                                                            VerticalAlignment="Center" Margin="10,0,0,0"
                                                            Tag="{Binding Token}"
                                                            Click="BtnFileEntry_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="FilesEmpty" Text="Nothing here."
                                               Style="{StaticResource T.Muted}" FontSize="12.5" TextWrapping="Wrap"
                                               Margin="10,16,10,18" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="FilesTruncated" Style="{StaticResource T.Base}"
                                       Foreground="{DynamicResource B.TextFaint}" FontSize="11.5"
                                       Margin="2,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                       Text="This folder has more in it than can be listed at once." />
                        </StackPanel>

                        <StackPanel x:Name="PageDevices" Visibility="Collapsed" MaxWidth="480">
                            <TextBlock Text="Your mesh" Style="{StaticResource T.Base}" FontSize="19"
                                       FontWeight="SemiBold" FontFamily="{DynamicResource F.Display}"
                                       Margin="0,22,0,4" />
                            <TextBlock Style="{StaticResource T.Muted}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="What to call this set of devices. A device that scans the code below joins under this name." />

                            <TextBox x:Name="MeshNameBox" Margin="0,10,0,0" Padding="10,7"
                                     MaxLength="40"
                                     FontSize="13.5"
                                     Background="{DynamicResource B.Surface}"
                                     Foreground="{DynamicResource B.Text}"
                                     BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                                     LostFocus="MeshNameBox_LostFocus" KeyDown="MeshNameBox_KeyDown" />

                            <!-- Devices waiting to be confirmed. Hidden until one knocks, so the
                                 page is unchanged in the ordinary case. The fingerprint here is
                                 the thing the user compares against the other device's screen:
                                 winning the race to connect no longer helps an attacker,
                                 because their fingerprint is not the one being shown. -->
                            <Border x:Name="PendingCard" Visibility="Collapsed" Margin="0,20,0,0"
                                    Background="{DynamicResource B.WarnSoft}"
                                    BorderBrush="{DynamicResource B.Warn}" BorderThickness="1"
                                    CornerRadius="10" Padding="16,14">
                                <StackPanel>
                                    <TextBlock x:Name="PendingHeading" Style="{StaticResource T.Base}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource B.Warn}"
                                               Text="A device wants to join" />
                                    <TextBlock Style="{StaticResource T.Muted}" FontSize="12" TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Text="Check this code matches the one shown on the other device before you allow it." />

                                    <ItemsControl x:Name="PendingList" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Code}" Style="{StaticResource T.Mono}"
                                                                   FontSize="15" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Muted}"
                                                                   FontSize="11.5" Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <Button Grid.Column="1" Style="{StaticResource S.BtnQuiet}"
                                                            Content="Reject" Padding="12,5" FontSize="11.5"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                                            Tag="{Binding Fingerprint}"
                                                            Click="BtnRejectPairing_Click" />

                                                    <Button Grid.Column="2" Style="{StaticResource S.BtnPrimary}"
                                                            Content="Allow" Padding="14,5" FontSize="11.5"
                                                            VerticalAlignment="Center"
                                                            Tag="{Binding Fingerprint}"
                                                            Click="BtnConfirmPairing_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="DevicesHeading" Text="Devices" Style="{StaticResource T.Base}"
                                       FontSize="19" FontWeight="SemiBold"
                                       FontFamily="{DynamicResource F.Display}" Margin="0,26,0,4" />
                            <TextBlock x:Name="DevicesSub" Style="{StaticResource T.Muted}" FontSize="12.5"
                                       TextWrapping="Wrap" Text="Everything paired into this mesh." />

                            <Border Style="{StaticResource S.Card}" Margin="0,12,0,0" Padding="6">
                                <StackPanel>
                                    <ItemsControl x:Name="DeviceList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="12,11">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Ellipse Grid.Column="0" Width="9" Height="9"
                                                             VerticalAlignment="Center" Margin="2,0,12,0"
                                                             Fill="{Binding Dot}" />

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}"
                                                                   FontSize="13.5" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Muted}"
                                                                   FontSize="11.5" Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <Button Grid.Column="2" Style="{StaticResource S.BtnQuiet}"
                                                            Content="Ring" Padding="12,5" FontSize="11.5"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                                            Visibility="{Binding RingVisibility}"
                                                            ToolTip="Make this device sound an alarm so you can find it"
                                                            Tag="{Binding Fingerprint}"
                                                            Click="BtnRingDevice_Click" />

                                                    <Button Grid.Column="3" Style="{StaticResource S.BtnQuiet}"
                                                            Content="Forget" Padding="12,5" FontSize="11.5"
                                                            VerticalAlignment="Center"
                                                            Tag="{Binding Fingerprint}"
                                                            Click="BtnForgetDevice_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="DevicesEmpty"
                                               Text="No devices yet. Add one with the code below."
                                               Style="{StaticResource T.Muted}" FontSize="12.5"
                                               HorizontalAlignment="Center" Margin="0,22,0,24" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Add a device" Style="{StaticResource T.Base}" FontSize="19"
                                       FontWeight="SemiBold" FontFamily="{DynamicResource F.Display}"
                                       Margin="0,26,0,4" />
                            <TextBlock Style="{StaticResource T.Muted}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="Open Mesh Sync on another device and scan this code with its camera." />

                            <Border Style="{StaticResource S.Card}" Margin="0,16,0,0" Padding="20">
                                <StackPanel>
                                    <Border Background="#FFFFFF" CornerRadius="10" Padding="12"
                                            HorizontalAlignment="Center"
                                            BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
                                        <Image x:Name="QrImage" Width="188" Height="188"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>

                                    <TextBlock x:Name="QrError" Visibility="Collapsed"
                                               Text="Could not draw the QR code. Use the details below instead."
                                               Style="{StaticResource T.Muted}" FontSize="12" TextWrapping="Wrap"
                                               TextAlignment="Center" Margin="0,0,0,10" />

                                    <Grid Margin="0,20,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Address" Style="{StaticResource T.Muted}"
                                                   FontSize="12.5" VerticalAlignment="Center" Width="74" />
                                        <TextBlock Grid.Column="1" x:Name="IpText" Style="{StaticResource T.Mono}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Key" Style="{StaticResource T.Muted}"
                                                   FontSize="12.5" VerticalAlignment="Center" Width="74" />
                                        <TextBlock Grid.Column="1" x:Name="CodeText" Style="{StaticResource T.Mono}"
                                                   Foreground="{DynamicResource B.TextMuted}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2" x:Name="BtnCopyCode" Style="{StaticResource S.BtnQuiet}"
                                                Content="Copy" Padding="14,6" FontSize="12"
                                                Click="BtnCopyCode_Click" Margin="10,0,0,0" />
                                    </Grid>

                                    <!-- This machine's own fingerprint. The other device shows the
                                         same four groups when it asks to be allowed in, and the
                                         two matching is what makes the pairing safe rather than
                                         merely quick. -->
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="This device" Style="{StaticResource T.Muted}"
                                                   FontSize="12.5" VerticalAlignment="Center" Width="74" />
                                        <TextBlock Grid.Column="1" x:Name="SelfFingerprint" Style="{StaticResource T.Mono}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Height="28" Background="Transparent" />
                        </StackPanel>

                        <!-- ─────────── SETTINGS ─────────── -->
                        <StackPanel x:Name="PageSettings" Visibility="Collapsed" MaxWidth="560">
                            <TextBlock Text="Settings" Style="{StaticResource T.Base}" FontSize="19"
                                       FontWeight="SemiBold" FontFamily="{DynamicResource F.Display}"
                                       Margin="0,22,0,16" />

                            <Border Style="{StaticResource S.Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock Text="Start with Windows" FontSize="13.5" />
                                            <TextBlock Text="Run quietly in the tray at sign-in"
                                                       Style="{StaticResource T.Muted}" FontSize="11.5"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" x:Name="StartupSwitch" Style="{StaticResource S.Switch}"
                                                  VerticalAlignment="Center" Click="StartupSwitch_Click" />
                                    </Grid>

                                    <Rectangle Height="1" Fill="{DynamicResource B.Border}" Margin="0,16" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock Text="Appearance" FontSize="13.5" />
                                            <TextBlock Text="Follow Windows, or pin one"
                                                       Style="{StaticResource T.Muted}" FontSize="11.5"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource B.SurfaceAlt}"
                                                CornerRadius="7" Padding="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="ThemeSystem" Style="{StaticResource S.Segment}"
                                                             GroupName="Theme" Content="Auto" Click="ThemeChoice_Click" />
                                                <RadioButton x:Name="ThemeLight" Style="{StaticResource S.Segment}"
                                                             GroupName="Theme" Content="Light" Click="ThemeChoice_Click" />
                                                <RadioButton x:Name="ThemeDark" Style="{StaticResource S.Segment}"
                                                             GroupName="Theme" Content="Dark" Click="ThemeChoice_Click" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Rectangle Height="1" Fill="{DynamicResource B.Border}" Margin="0,16" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock Text="Diagnostic log" FontSize="13.5" />
                                            <TextBlock Text="Open the folder containing daemon.log"
                                                       Style="{StaticResource T.Muted}" FontSize="11.5"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource S.BtnQuiet}"
                                                Content="Open" Padding="14,6" FontSize="12"
                                                VerticalAlignment="Center" Click="BtnOpenLogs_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource S.Card}" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <TextBlock Text="Quit Mesh Sync" FontSize="13.5" />
                                        <TextBlock Text="Stops syncing until you launch it again"
                                                   Style="{StaticResource T.Muted}" FontSize="11.5"
                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource S.BtnQuiet}"
                                            Content="Quit" Padding="14,6" FontSize="12"
                                            Foreground="{DynamicResource B.Danger}"
                                            VerticalAlignment="Center" Click="BtnQuit_Click" />
                                </Grid>
                            </Border>
                            <Border Height="28" Background="Transparent" />
                        </StackPanel>

                        <!-- ─────────── ABOUT ─────────── -->
                        <StackPanel x:Name="PageAbout" Visibility="Collapsed" MaxWidth="460">
                            <Viewbox Width="128" Height="76" HorizontalAlignment="Center" Margin="0,44,0,0">
                                <Canvas Width="167" Height="99">
                                    <Ellipse Canvas.Left="5.5" Canvas.Top="5.5" Width="88" Height="88"
                                             Stroke="{DynamicResource B.Accent}" StrokeThickness="11" Fill="Transparent" />
                                    <Ellipse Canvas.Left="73.5" Canvas.Top="5.5" Width="88" Height="88"
                                             Stroke="{DynamicResource B.Accent}" StrokeThickness="11" Fill="Transparent" />
                                    <Path Fill="{DynamicResource B.Accent}"
                                          Data="M 83.5 21.6 A 44 44 0 0 1 83.5 77.4 A 44 44 0 0 1 83.5 21.6 Z" />
                                </Canvas>
                            </Viewbox>

                            <TextBlock Text="MESH SYNC" FontFamily="{DynamicResource F.Display}" FontSize="19"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,0" />
                            <TextBlock x:Name="AboutVersion" Style="{StaticResource T.Muted}" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" Text="Version" />

                            <Border Style="{StaticResource S.Card}" Margin="0,26,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource T.Base}" TextWrapping="Wrap" FontSize="13"
                                               Text="Your clipboard, shared between your own devices. Over your network, or directly over Bluetooth when there is no network at all." />
                                    <Rectangle Height="1" Fill="{DynamicResource B.Border}" Margin="0,14" />
                                    <TextBlock Style="{StaticResource T.Muted}" FontSize="12.5" TextWrapping="Wrap"
                                               Text="Nothing is uploaded and there is no account. Each pair of devices has its own key, so a copy is encrypted for the device it is going to and never written to disk." />
                                </StackPanel>
                            </Border>
                            <Border Height="28" Background="Transparent" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Background="{DynamicResource B.Bg}" Padding="28,10,28,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="FooterHint"
                                   Style="{StaticResource T.Base}" FontSize="11"
                                   Foreground="{DynamicResource B.TextFaint}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                                   Text="Nothing ever leaves your own devices" />
                        <Button Grid.Column="1" Style="{StaticResource S.BtnQuiet}" Content="Hide to tray"
                                Padding="16,7" Click="BtnHide_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
