<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ═══════════════════════════════════════════════════════════════
         Palette - light, calm, minimal.
         Colours are declared here and overwritten in place by ThemeManager
         for the dark variant, so every brush below follows automatically.
         ═══════════════════════════════════════════════════════════════ -->

    <Color x:Key="C.Bg">#F7F6F3</Color>
    <Color x:Key="C.Surface">#FFFFFF</Color>
    <Color x:Key="C.SurfaceAlt">#F1EFEA</Color>
    <Color x:Key="C.Border">#E5E1DA</Color>
    <Color x:Key="C.BorderStrong">#D3CEC5</Color>
    <Color x:Key="C.Text">#262523</Color>
    <Color x:Key="C.TextMuted">#77726A</Color>
    <Color x:Key="C.TextFaint">#A39D94</Color>

    <Color x:Key="C.Accent">#2F7A6B</Color>
    <Color x:Key="C.AccentHover">#28695C</Color>
    <Color x:Key="C.AccentSoft">#E6F1EE</Color>

    <Color x:Key="C.Warn">#B0722F</Color>
    <Color x:Key="C.WarnSoft">#FBF1E3</Color>

    <Color x:Key="C.Danger">#B0524A</Color>
    <Color x:Key="C.DangerSoft">#FAEBE9</Color>

    <Color x:Key="C.Shadow">#1A000000</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="B.Bg"          Color="{DynamicResource C.Bg}" />
    <SolidColorBrush x:Key="B.Surface"     Color="{DynamicResource C.Surface}" />
    <SolidColorBrush x:Key="B.SurfaceAlt"  Color="{DynamicResource C.SurfaceAlt}" />
    <SolidColorBrush x:Key="B.Border"      Color="{DynamicResource C.Border}" />
    <SolidColorBrush x:Key="B.BorderStrong" Color="{DynamicResource C.BorderStrong}" />
    <SolidColorBrush x:Key="B.Text"        Color="{DynamicResource C.Text}" />
    <SolidColorBrush x:Key="B.TextMuted"   Color="{DynamicResource C.TextMuted}" />
    <SolidColorBrush x:Key="B.TextFaint"   Color="{DynamicResource C.TextFaint}" />
    <SolidColorBrush x:Key="B.Accent"      Color="{DynamicResource C.Accent}" />
    <SolidColorBrush x:Key="B.AccentHover" Color="{DynamicResource C.AccentHover}" />
    <SolidColorBrush x:Key="B.AccentSoft"  Color="{DynamicResource C.AccentSoft}" />
    <SolidColorBrush x:Key="B.Warn"        Color="{DynamicResource C.Warn}" />
    <SolidColorBrush x:Key="B.WarnSoft"    Color="{DynamicResource C.WarnSoft}" />
    <SolidColorBrush x:Key="B.Danger"      Color="{DynamicResource C.Danger}" />
    <SolidColorBrush x:Key="B.DangerSoft"  Color="{DynamicResource C.DangerSoft}" />

    <!-- Type -->
    <FontFamily x:Key="F.Sans">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <sys:Double x:Key="R.Card">10</sys:Double>
    <CornerRadius x:Key="CR.Card">10</CornerRadius>
    <CornerRadius x:Key="CR.Pill">999</CornerRadius>

    <!-- ═══════════════════════ Base text ═══════════════════════ -->

    <Style TargetType="TextBlock" x:Key="T.Base">
        <Setter Property="FontFamily" Value="{DynamicResource F.Sans}" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Base}" />

    <Style TargetType="TextBlock" x:Key="T.SectionLabel" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextFaint}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style TargetType="TextBlock" x:Key="T.Muted" BasedOn="{StaticResource T.Base}">
        <Setter Property="Foreground" Value="{DynamicResource B.TextMuted}" />
    </Style>

    <Style TargetType="TextBlock" x:Key="T.Mono" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontFamily" Value="{DynamicResource F.Mono}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ═══════════════════════ Card ═══════════════════════ -->

    <Style TargetType="Border" x:Key="S.Card">
        <Setter Property="Background" Value="{DynamicResource B.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CR.Card}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ═══════════════════════ Buttons ═══════════════════════ -->

    <Style TargetType="Button" x:Key="S.BtnBase">
        <Setter Property="FontFamily" Value="{DynamicResource F.Sans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.74" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="S.BtnPrimary" BasedOn="{StaticResource S.BtnBase}">
        <Setter Property="Background" Value="{DynamicResource B.Accent}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="Button" x:Key="S.BtnQuiet" BasedOn="{StaticResource S.BtnBase}">
        <Setter Property="Background" Value="{DynamicResource B.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- Window caption buttons -->
    <Style TargetType="Button" x:Key="S.BtnCaption">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextMuted}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.SurfaceAlt}" />
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="S.BtnCaptionClose" BasedOn="{StaticResource S.BtnCaption}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
        </Style.Triggers>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C0453C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════ Disclosure (collapsible row) ═══════════════════════ -->

    <Style TargetType="ToggleButton" x:Key="S.Disclosure">
        <Setter Property="FontFamily" Value="{DynamicResource F.Sans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{DynamicResource B.Surface}"
                            BorderBrush="{DynamicResource B.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CR.Card}"
                            Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" />
                            <Path x:Name="Chev" Grid.Column="1"
                                  Data="M 0,0 L 4.5,5 L 9,0"
                                  Stroke="{DynamicResource B.TextMuted}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- Replaces the whole transform: a Setter cannot target a
                                 Transform by name, only a templated element. -->
                            <Setter TargetName="Chev" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════ Toggle switch ═══════════════════════ -->

    <Style TargetType="CheckBox" x:Key="S.Switch">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="38" Height="22" CornerRadius="11"
                            Background="{DynamicResource B.BorderStrong}">
                        <Ellipse x:Name="Knob" Width="16" Height="16" Fill="#FFFFFF"
                                 HorizontalAlignment="Left" Margin="3,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource B.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════ Segmented control ═══════════════════════ -->

    <Style TargetType="RadioButton" x:Key="S.Segment">
        <Setter Property="FontFamily" Value="{DynamicResource F.Sans}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="11,4" Margin="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Surface}" />
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════ ScrollViewer (thin, calm) ═══════════════════════ -->

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource B.BorderStrong}"
                                                    CornerRadius="4" Width="6" Margin="1,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
