<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AndroidClient.SetupPage"
             Style="{StaticResource MeshPage}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,0">

        <!-- ══════════ Header + progress ══════════ -->
        <VerticalStackLayout Grid.Row="0" Spacing="14" Margin="0,28,0,0">

            <Label Text="Set up Mesh Sync" Style="{StaticResource T.Title}" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" HeightRequest="4">
                <BoxView x:Name="Bar1" Grid.Column="0" CornerRadius="2"
                         Color="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                <BoxView x:Name="Bar2" Grid.Column="1" CornerRadius="2"
                         Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource BorderDark}}" />
                <BoxView x:Name="Bar3" Grid.Column="2" CornerRadius="2"
                         Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource BorderDark}}" />
            </Grid>

            <Label x:Name="StepCounter" Text="Step 1 of 3" Style="{StaticResource T.Faint}" />
        </VerticalStackLayout>

        <!-- ══════════ Step body ══════════ -->
        <ScrollView Grid.Row="1" x:Name="StepScroll" Margin="0,20,0,0"
                    VerticalScrollBarVisibility="Never">
            <!-- StepCanvas is stretched to the viewport height in code-behind so short
                 steps sit centred instead of hugging the top, while long ones still scroll. -->
            <Grid x:Name="StepCanvas">
            <VerticalStackLayout Spacing="0" VerticalOptions="Center">

                <!-- Illustration. One per step, from the brand asset set. -->
                <Grid HeightRequest="180" HorizontalOptions="Center" Margin="0,4,0,14">
                    <Image x:Name="IconPair" Source="illo_pair.png"
                           HeightRequest="180" WidthRequest="180" Aspect="AspectFit" />
                    <Image x:Name="IconClipboard" Source="illo_copy.png" IsVisible="False"
                           HeightRequest="180" WidthRequest="180" Aspect="AspectFit" />
                    <Image x:Name="IconImage" Source="illo_send.png" IsVisible="False"
                           HeightRequest="180" WidthRequest="180" Aspect="AspectFit" />
                </Grid>

                <Label x:Name="StepTitle" Text="Pair with another device"
                       Style="{StaticResource T.Display}" FontSize="23"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="StepBody" Style="{StaticResource T.Muted}"
                       HorizontalTextAlignment="Center" Margin="6,12,6,0"
                       Text="Open Mesh Sync on the other device and point your camera at the code it shows." />

                <!-- Reassurance -->
                <Border Style="{StaticResource S.Card}" Margin="0,22,0,0" Padding="14"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                        Stroke="Transparent">
                    <Label x:Name="StepNote" Style="{StaticResource T.Faint}"
                           HorizontalTextAlignment="Center"
                           Text="Nothing ever leaves your own devices. There is no cloud account." />
                </Border>

                <!-- Manual pairing (step 1 only) -->
                <VerticalStackLayout x:Name="ManualPanel" IsVisible="False" Spacing="10" Margin="0,18,0,0">
                    <Border Style="{StaticResource S.Card}" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Its address" Style="{StaticResource T.Faint}" />
                            <Entry x:Name="IpEntry" Style="{StaticResource S.Entry}"
                                   Placeholder="192.168.1.100" Keyboard="Url"
                                   ClearButtonVisibility="WhileEditing" />
                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                            <Label Text="Pairing key" Style="{StaticResource T.Faint}" />
                            <Entry x:Name="CodeEntry" Style="{StaticResource S.Entry}"
                                   Placeholder="Paste the key from the other device"
                                   ClearButtonVisibility="WhileEditing" />
                            <Button Text="Pair" Style="{StaticResource S.BtnOutline}"
                                    Clicked="OnManualPairClicked" Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- ══════════ Actions ══════════ -->
        <VerticalStackLayout Grid.Row="2" Spacing="2" Margin="0,8,0,20">
            <Button x:Name="PrimaryButton" Style="{StaticResource S.BtnPrimary}"
                    Text="Open camera instructions" Clicked="OnPrimaryClicked" />
            <Button x:Name="SecondaryButton" Style="{StaticResource S.BtnQuiet}"
                    Text="Enter details manually" Clicked="OnSecondaryClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
