<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AndroidClient.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AndroidClient"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Title="Mesh Sync">

    <!-- Setup first; the shell picks the start route at runtime. -->
    <ShellContent
        Route="setup"
        ContentTemplate="{DataTemplate local:SetupPage}" />

    <ShellContent
        Route="dashboard"
        ContentTemplate="{DataTemplate local:DashboardPage}" />

</Shell>
