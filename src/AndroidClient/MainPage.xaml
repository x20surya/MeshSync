<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AndroidClient.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,50"
            Spacing="25">
            <Image
                Source="dotnet_bot.png"
                HeightRequest="150"
                Aspect="AspectFit" />

            <Label
                Text="Universal Clipboard"
                Style="{StaticResource Headline}"
                HorizontalOptions="Center"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Secure Local-First Sync"
                Style="{StaticResource SubHeadline}"
                HorizontalOptions="Center"
                SemanticProperties.HeadingLevel="Level2" />

            <Border StrokeShape="RoundRectangle 10" Stroke="Gray" BackgroundColor="Transparent" Padding="20" Margin="0,20,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Background Service Status" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label x:Name="StatusLabel" Text="Checking..." TextColor="Orange" HorizontalOptions="Center"/>
                    
                    <Button
                        x:Name="EnableServiceBtn"
                        Text="Enable in Android Settings" 
                        SemanticProperties.Hint="Opens accessibility settings to allow clipboard access"
                        Clicked="OnEnableServiceClicked"
                        HorizontalOptions="Fill"
                        Margin="0,15,0,0" />
                        
                    <Button
                        x:Name="RequestScreenshotBtn"
                        Text="Grant Screenshot Permission" 
                        SemanticProperties.Hint="Requests photo permission to beam screenshots"
                        Clicked="OnRequestScreenshotClicked"
                        HorizontalOptions="Fill"
                        Margin="0,5,0,0" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 10" Stroke="Gray" BackgroundColor="Transparent" Padding="20" Margin="0,10,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Mesh Pairing (Test Mode)" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label x:Name="NetworkStatusLabel" Text="Disconnected" TextColor="Red" HorizontalOptions="Center"/>
                    
                    <Label Text="Host Pairing Code:" FontSize="12" Margin="0,10,0,0"/>
                    <Entry x:Name="PairingCodeEntry" Placeholder="Paste laptop's Base64 code here..." ClearButtonVisibility="WhileEditing" />
                    
                    <Label Text="Laptop Wi-Fi IP Address:" FontSize="12" Margin="0,5,0,0"/>
                    <Entry x:Name="IpAddressEntry" Placeholder="e.g. 192.168.1.100" Keyboard="Url" ClearButtonVisibility="WhileEditing" />
                    
                    <Button
                        x:Name="ConnectBtn"
                        Text="Connect to Laptop" 
                        Clicked="OnConnectClicked"
                        HorizontalOptions="Fill" />
                        
                    <Label Text="Received Clipboard:" FontSize="12" Margin="0,10,0,0"/>
                    <Editor x:Name="ReceivedTextEditor" IsReadOnly="True" HeightRequest="60" BackgroundColor="#222" TextColor="White" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
