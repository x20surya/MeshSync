<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AndroidClient.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,50"
            Spacing="25">
            <Image
                Source="dotnet_bot.png"
                HeightRequest="150"
                Aspect="AspectFit" />

            <Label
                Text="Universal Clipboard"
                Style="{StaticResource Headline}"
                HorizontalOptions="Center"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Secure Local-First Sync"
                Style="{StaticResource SubHeadline}"
                HorizontalOptions="Center"
                SemanticProperties.HeadingLevel="Level2" />

            <Border StrokeShape="RoundRectangle 10" Stroke="Gray" BackgroundColor="Transparent" Padding="20" Margin="0,20,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Background Service Status" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label x:Name="StatusLabel" Text="Checking..." TextColor="Orange" HorizontalOptions="Center"/>
                    
                    <Button
                        x:Name="EnableServiceBtn"
                        Text="Enable in Android Settings" 
                        SemanticProperties.Hint="Opens accessibility settings to allow clipboard access"
                        Clicked="OnEnableServiceClicked"
                        HorizontalOptions="Fill"
                        Margin="0,15,0,0" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
