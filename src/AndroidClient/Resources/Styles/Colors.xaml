<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         Mesh Sync palette - light, calm, minimal.
         The template's original key names are kept and repointed, so every
         built-in MAUI style inherits the new palette without being rewritten.
         ═══════════════════════════════════════════════════════════════ -->

    <Color x:Key="Primary">#2F7A6B</Color>
    <Color x:Key="PrimaryDark">#4FA894</Color>
    <Color x:Key="PrimaryDarkText">#262523</Color>
    <Color x:Key="Secondary">#E6F1EE</Color>
    <Color x:Key="SecondaryDarkText">#4FA894</Color>
    <Color x:Key="Tertiary">#F0E3D0</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#17181A</Color>
    <Color x:Key="Magenta">#B0524A</Color>
    <Color x:Key="MidnightBlue">#1C2E2A</Color>
    <Color x:Key="OffBlack">#1F2124</Color>

    <!-- Warm neutral ramp - deliberately not pure grey, to match the off-white ground -->
    <Color x:Key="Gray100">#E5E1DA</Color>
    <Color x:Key="Gray200">#D3CEC5</Color>
    <Color x:Key="Gray300">#B8B2A8</Color>
    <Color x:Key="Gray400">#9C968D</Color>
    <Color x:Key="Gray500">#77726A</Color>
    <Color x:Key="Gray600">#4A4741</Color>
    <Color x:Key="Gray900">#262523</Color>
    <Color x:Key="Gray950">#17181A</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- ═══════════ Semantic pairs, consumed via AppThemeBinding ═══════════ -->

    <Color x:Key="PageBgLight">#F7F6F3</Color>
    <Color x:Key="PageBgDark">#17181A</Color>

    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1F2124</Color>

    <Color x:Key="SurfaceAltLight">#F1EFEA</Color>
    <Color x:Key="SurfaceAltDark">#282B2E</Color>

    <Color x:Key="BorderLight">#E5E1DA</Color>
    <Color x:Key="BorderDark">#2E3134</Color>

    <Color x:Key="TextLight">#262523</Color>
    <Color x:Key="TextDark">#E9E7E3</Color>

    <Color x:Key="MutedLight">#77726A</Color>
    <Color x:Key="MutedDark">#9C978F</Color>

    <Color x:Key="FaintLight">#A39D94</Color>
    <Color x:Key="FaintDark">#726E68</Color>

    <Color x:Key="AccentLight">#2F7A6B</Color>
    <Color x:Key="AccentDark">#4FA894</Color>

    <Color x:Key="AccentSoftLight">#E6F1EE</Color>
    <Color x:Key="AccentSoftDark">#1C2E2A</Color>

    <Color x:Key="WarnLight">#B0722F</Color>
    <Color x:Key="WarnDark">#D69A5A</Color>

    <Color x:Key="WarnSoftLight">#FBF1E3</Color>
    <Color x:Key="WarnSoftDark">#2E2620</Color>

    <Color x:Key="DangerLight">#B0524A</Color>
    <Color x:Key="DangerDark">#D4776E</Color>

</ResourceDictionary>
