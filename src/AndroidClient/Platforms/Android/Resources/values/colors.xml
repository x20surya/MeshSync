<?xml version="1.0" encoding="utf-8" ?>
<resources>
    <!--
        Brand colours, replacing the MAUI template's purple. The template values were never
        changed, so opening the drawer tinted the status bar #512BD4 against a warm off-white
        and near-black palette - the one place in either app that was not Mesh Sync's own.

        colorPrimary is the status bar band behind the drawer, and it is deliberately the page
        background rather than the accent: a teal band across the top is no less wrong than a
        purple one. Buttons and accents come from the XAML palette, not from here.
    -->
    <color name="colorPrimary">#F7F6F3</color>
    <color name="colorPrimaryDark">#F7F6F3</color>
    <color name="colorAccent">#2F7A6B</color>
</resources>
