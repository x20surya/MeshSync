<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
	<!-- allowBackup is false deliberately. The app's private directory holds device.key and
	     peers.json, and a cloud backup would carry this device's identity off the device and
	     restore it onto another one - which is a clone, not a restore, and would let two
	     machines answer as the same peer. dataExtractionRules says the same thing to Android 12
	     and above, which ignores allowBackup for cloud transfers. Losing them costs a re-pair,
	     which is visible and cheap; the alternative is not. -->
	<application android:allowBackup="false"
	             android:dataExtractionRules="@xml/data_extraction_rules"
	             android:fullBackupContent="false"
	             android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true">
		<provider
			android:name="androidx.core.content.FileProvider"
			android:authorities="dev.meshsync.app.fileprovider"
			android:exported="false"
			android:grantUriPermissions="true">
			<meta-data
				android:name="android.support.FILE_PROVIDER_PATHS"
				android:resource="@xml/file_paths" />
		</provider>
	</application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Superseded by the BLUETOOTH_* runtime permissions on Android 12. -->
	<uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
	<uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

	<!-- neverForLocation says we only look for our own service UUID and derive nothing about
	     where the user is. Without it Android 12+ ties BLE scanning to location: the user is
	     asked for a location permission they should not need, and scans silently return
	     nothing whenever location services happen to be switched off. -->
	<uses-permission android:name="android.permission.BLUETOOTH_SCAN"
	                 android:usesPermissionFlags="neverForLocation"
	                 tools:targetApi="s" />
	<uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
	<uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

	<!-- Only Android 11 and below needed location to scan for BLE devices. -->
	<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<!-- Turns a package name into the name a person recognises.

	     Android 11 hid every other installed app behind package visibility, and
	     PackageManager.getApplicationInfo throws NameNotFoundException without this - which
	     NameOf catches and answers with the package name. So the mute list read
	     "in.swiggy.android" rather than "Swiggy", and worse, every notification mirrored to the
	     desktop was labelled with the package too. System packages are always visible, which is
	     why "Android System" resolved and nothing else did.

	     Broad rather than a <queries> block because there is no narrower question to ask: the
	     apps whose names are wanted are whichever ones happen to notify, which is not knowable
	     in advance. Play restricts this permission to a short list of app types; Mesh Sync ships
	     from a GitHub release, and it reads names only - it never enumerates what is installed. -->
	<uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

	<!-- The pairing scanner. Pairing used to leave for whatever camera app answered
	     STILL_IMAGE_CAMERA, which is only a QR reader if that particular camera happens to be
	     one - so on a stock OEM camera the first thing the app ever asks of a user simply did
	     not work. required="false" because everything except scanning works without a camera,
	     and a phone with none must still be able to install and be joined by manual entry. -->
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-feature android:name="android.hardware.camera" android:required="false" />
	<uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
	<uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

	<!-- Ringing a lost phone. Without this the sound still plays but the buzz does not, which is
	     the half that finds a phone face-down in a sofa. Android throws a SecurityException for
	     the vibrate call rather than ignoring it, so the omission was silent until a real ring
	     was tried on a real device. Normal permission: granted at install, never prompted. -->
	<uses-permission android:name="android.permission.VIBRATE" />

	<!-- The links are held by a real foreground service now. Before this there was an ongoing
	     notification and no startForeground behind it, so Android would not keep a socket open
	     in that context and Doze eventually killed it. connectedDevice is the type that
	     describes what is actually being held; on Android 14+ it is granted on the strength of
	     BLUETOOTH_CONNECT above. -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

	<!-- The accessibility service used to be what came back after a restart, because Android
	     rebinds an enabled one on boot. Removing it removed boot persistence with it, so this
	     is what brings the links back now. Receiving BOOT_COMPLETED is also one of the
	     exemptions from the Android 12 ban on starting a foreground service from the
	     background, which is what makes it the right place to do it. -->
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

	<!-- Asked for once, from a tap, and never nagged. The foreground service is the mechanism
	     that holds the links, but several OEM battery managers stop one anyway once the phone
	     has been idle a while - which reads as "sync is unreliable" rather than as a setting.
	     Only the ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS dialog needs this; the settings
	     screen it falls back to does not. -->
	<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
</manifest>