<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AndroidClient"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="AndroidClient.DevicesPage"
             Style="{StaticResource MeshPage}">

    <ScrollView>
        <VerticalStackLayout Padding="20,26,20,32" Spacing="0">

            <local:MeshHeader x:Name="Header" Title="Devices" />

            <!-- ══════════ Waiting to be allowed in ══════════
                 Hidden until something knocks, so the page is unchanged in the ordinary case.
                 The code shown here is what the user compares against the other device's
                 screen: winning the race to connect no longer helps an attacker, because
                 their fingerprint is not the one being displayed over there. -->
            <Border x:Name="PendingCard" IsVisible="False" Margin="0,0,0,16"
                    StrokeThickness="1" Padding="16,14"
                    Stroke="{AppThemeBinding Light={StaticResource WarnLight}, Dark={StaticResource WarnDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource WarnSoftLight}, Dark={StaticResource WarnSoftDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="4">
                    <Label x:Name="PendingHeading" Style="{StaticResource T.Body}"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource WarnLight}, Dark={StaticResource WarnDark}}"
                           Text="A device wants to join" />
                    <Label Style="{StaticResource T.Muted}" FontSize="12"
                           Text="Check this code matches the one shown on the other device before you allow it." />

                    <CollectionView x:Name="PendingList" SelectionMode="None" Margin="0,8,0,0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,7">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Code}" Style="{StaticResource T.Mono}"
                                               FontSize="15" FontAttributes="Bold" />
                                        <Label Text="{Binding Name}" Style="{StaticResource T.Faint}"
                                               FontSize="11.5" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <Button Grid.Column="1" Text="Reject" Style="{StaticResource S.BtnQuiet}"
                                            FontSize="12" Padding="12,4" VerticalOptions="Center"
                                            CommandParameter="{Binding Fingerprint}"
                                            Clicked="OnRejectPairingClicked" />

                                    <Button Grid.Column="2" Text="Allow" Style="{StaticResource S.BtnPrimary}"
                                            FontSize="12" Padding="14,4" VerticalOptions="Center"
                                            CommandParameter="{Binding Fingerprint}"
                                            Clicked="OnConfirmPairingClicked" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- ══════════ Paired devices ══════════ -->
            <Label x:Name="DevicesSub" Style="{StaticResource T.Muted}" FontSize="12.5"
                   Margin="4,0,4,10" Text="Everything paired into this mesh." />

            <Border Style="{StaticResource S.Card}" Padding="4">
                <VerticalStackLayout>
                    <CollectionView x:Name="DeviceList" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="12,12">
                                    <Ellipse Grid.Column="0" WidthRequest="9" HeightRequest="9"
                                             VerticalOptions="Center" Fill="{Binding Dot}" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Name}" Style="{StaticResource T.Body}"
                                               FontSize="14" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Detail}" Style="{StaticResource T.Faint}"
                                               FontSize="11.5" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <Button Grid.Column="2" Text="Forget" Style="{StaticResource S.BtnQuiet}"
                                            FontSize="11.5" Padding="12,4" HeightRequest="32"
                                            VerticalOptions="Center"
                                            CommandParameter="{Binding Fingerprint}"
                                            Clicked="OnForgetClicked" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label x:Name="DevicesEmpty" Style="{StaticResource T.Muted}" FontSize="12.5"
                           HorizontalOptions="Center" Margin="0,24,0,26"
                           Text="No devices yet.&#10;Add one to start syncing." HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- ══════════ Add another ══════════ -->
            <Label Text="Add a device" Style="{StaticResource T.Title}" FontSize="17"
                   Margin="4,26,4,4" />
            <Label Style="{StaticResource T.Muted}" FontSize="12.5" Margin="4,0,4,12"
                   Text="Open Mesh Sync on the other device, show its pairing code, and scan it." />

            <Button x:Name="ScanButton" Text="Scan a pairing code" Style="{StaticResource S.BtnPrimary}"
                    Clicked="OnScanClicked" />

            <Button x:Name="ManualButton" Text="Enter details instead" Style="{StaticResource S.BtnQuiet}"
                    Margin="0,10,0,0" Clicked="OnManualToggled" />

            <Border x:Name="ManualCard" IsVisible="False" Style="{StaticResource S.Card}" Margin="0,12,0,0">
                <VerticalStackLayout Padding="16" Spacing="10">
                    <Label Text="Its address" Style="{StaticResource T.Muted}" FontSize="12" />
                    <Entry x:Name="AddressEntry" Style="{StaticResource S.Entry}"
                           Placeholder="192.168.0.10" Keyboard="Url" />

                    <Label Text="Pairing key" Style="{StaticResource T.Muted}" FontSize="12" Margin="0,4,0,0" />
                    <Entry x:Name="KeyEntry" Style="{StaticResource S.Entry}"
                           Placeholder="Paste the key from the other device" />

                    <Button Text="Add device" Style="{StaticResource S.BtnPrimary}" Margin="0,6,0,0"
                            Clicked="OnManualAddClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- ══════════ This device ══════════ -->
            <Label Text="This device" Style="{StaticResource T.Title}" FontSize="17" Margin="4,28,4,4" />
            <Label Style="{StaticResource T.Muted}" FontSize="12.5" Margin="4,0,4,12"
                   Text="Its own identity, for another device to add it." />

            <Border Style="{StaticResource S.Card}">
                <VerticalStackLayout Padding="16" Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Name" Style="{StaticResource T.Muted}"
                               FontSize="12.5" WidthRequest="66" VerticalOptions="Center" />
                        <Label Grid.Column="1" x:Name="SelfName" Style="{StaticResource T.Body}"
                               FontSize="13.5" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Address" Style="{StaticResource T.Muted}"
                               FontSize="12.5" WidthRequest="66" VerticalOptions="Center" />
                        <Label Grid.Column="1" x:Name="SelfAddress" Style="{StaticResource T.Mono}"
                               FontSize="12.5" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Key" Style="{StaticResource T.Muted}"
                               FontSize="12.5" WidthRequest="66" VerticalOptions="Center" />
                        <Label Grid.Column="1" x:Name="SelfKey" Style="{StaticResource T.Mono}"
                               FontSize="12.5" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                        <Button Grid.Column="2" Text="Copy" Style="{StaticResource S.BtnQuiet}"
                                FontSize="11.5" Padding="12,4" HeightRequest="32"
                                Clicked="OnCopyKeyClicked" />
                    </Grid>

                    <!-- This phone's own fingerprint. The other device shows the same four
                         groups when it asks to be allowed in, and the two matching is what
                         makes the pairing safe rather than merely quick. -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Code" Style="{StaticResource T.Muted}"
                               FontSize="12.5" WidthRequest="66" VerticalOptions="Center" />
                        <Label Grid.Column="1" x:Name="SelfFingerprint" Style="{StaticResource T.Mono}"
                               FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                               LineBreakMode="TailTruncation" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
